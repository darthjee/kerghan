#!/usr/bin/env bash
# Test stub for the docker CLI: logs its call and fakes the few queries the
# kerghan client makes.
#   STUB_VOLUME_EXISTS=1   vault-kerghan-data exists
#   STUB_RUNNING_IMAGE     image of the vault-kerghan container (unset: none)
#   STUB_RUNNING_STATE     its .State.Running (default true)
#   STUB_RUNNING_PORT      its host port for 80/tcp (default 3000)
echo "docker $*" >>"$STUB_LOG"
case "${1:-} ${2:-}" in
  "volume inspect")
    [ "${STUB_VOLUME_EXISTS:-0}" = "1" ] && exit 0
    echo "Error: No such volume: $3" >&2
    exit 1
    ;;
  "volume rm")
    [ "${STUB_VOLUME_EXISTS:-0}" = "1" ] && echo "$3" && exit 0
    echo "Error: No such volume: $3" >&2
    exit 1
    ;;
esac
if [ "${1:-}" = "inspect" ]; then
  if [ -z "${STUB_RUNNING_IMAGE:-}" ]; then
    echo "Error: No such object: vault-kerghan" >&2
    exit 1
  fi
  case "${3:-}" in
    *State.Running*) echo "${STUB_RUNNING_STATE:-true}" ;;
    *Config.Image*) echo "$STUB_RUNNING_IMAGE" ;;
    *HostPort*) echo "${STUB_RUNNING_PORT:-3000}" ;;
    *) echo "unexpected inspect format: $3" >&2; exit 1 ;;
  esac
  exit 0
fi
exit 0
