# Example settings for the kerghan client.
#
# Copy this file to ~/.kerghan/config and uncomment the settings you want to
# change. The file is optional; every setting has a default.
#
# Format: one key=value per line. Blank lines and # comments (whole line or
# trailing) are ignored, and surrounding whitespace is trimmed. An empty value
# uses the default. Unknown keys only print a warning; a line without "=" or an
# invalid value makes up, down, reset and update-env fail with the line number,
# without touching the instance.
#
# Precedence: command-line flag, then this file, then the default.
#
# A changed port, variant, image-tag, auto-login or bind recreates the instance
# on the next `kerghan up` (the data volume is kept). A changed runtime or
# stop-timeout applies the next time the container is created; run
# `kerghan down && kerghan up` to apply it now.

# Host port Kerghan is served on (http://localhost:<port>). 1-65535.
# Overridden by `kerghan up -p PORT`.
#port=3000

# Image variant: online | offline. The offline variant ships its inner images
# preloaded. `kerghan up --offline` selects offline even when this is online.
#variant=online

# How Vault runs the Docker-in-Docker container: auto | sysbox | privileged.
# auto uses Sysbox when it is installed and falls back to --privileged.
#runtime=auto

# Seconds to wait for a graceful stop before the container is killed, on
# `kerghan up` (applied when the container is created), `down` and `reset`.
# A positive integer.
#stop-timeout=60

# Override of the image tag pinned in this kerghan release. Replaces only the
# version part: the -offline suffix is still added for the offline variant
# (image-tag=0.4.0 with --offline runs darthjee/kerghan-standalone:0.4.0-offline).
# With an x.y.z tag the usual upgrade rules and downgrade guard apply against
# it; with any other tag (e.g. latest) `up` only checks that the running image
# and port match. Leave empty to use the pinned tag.
#image-tag=

# Automatic login as the default user (admin): true | false.
# When on, anyone who can reach the port is logged in as admin, with no login
# step; keep bind on a loopback address (the default) unless you mean it.
# When off, log in manually as admin with the KERGHAN_DEFAULT_USER_PASSWORD
# generated in ~/.kerghan/kerghan.env. Sessions created by automatic login stay
# valid until they expire after you turn it off.
# Needs the KERGHAN_DEFAULT_USER_* values in kerghan.env: a kerghan.env created
# by an older client has none, so the default is then false, and setting it to
# true makes `kerghan up` fail. Run `kerghan update-env` to add them (it keeps
# every existing value), then `kerghan up` again.
# Overridden by `kerghan up --auto-login` / `kerghan up --no-auto-login`.
#auto-login=true

# Host address (IPv4) the port is published on. Defaults to 127.0.0.1 (this
# machine only) when auto-login is on, and 0.0.0.0 (every interface) when it
# is off. With auto-login on, a non-loopback address (e.g. 0.0.0.0) prints a
# warning on `kerghan up`, because anyone who can reach the port is logged in
# as admin, but still starts. Overridden by `kerghan up --bind ADDRESS`.
#bind=
