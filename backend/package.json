{
  "name": "kerghan-backend",
  "type": "module",
  "version": "0.1.0",
  "description": "Kerghan backend — GitHub issue monitoring/dashboard API",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "server": "node dist/main.js",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "migration:run": "typeorm-ts-node-esm migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-esm migration:revert -d src/database/data-source.ts",
    "spec": "npx jasmine \"spec/**/*[sS]pec.js\"",
    "test": "npx c8 jasmine \"spec/**/*[sS]pec.js\"",
    "coverage": "npx c8 --reporter=lcov jasmine \"spec/**/*[sS]pec.js\"",
    "lint": "eslint lib spec src",
    "lint_fix": "eslint lib spec src --fix"
  },
  "author": "darthjee",
  "license": "UNLICENSED",
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "mysql2": "^3.11.0",
    "dotenv": "^16.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@eslint/js": "^8.0.0",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "c8": "11.0.0",
    "ts-node": "^10.9.2",
    "eslint": "^8.0.1",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-complexity": "^1.0.2",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jasmine": "^4.1.3",
    "eslint-plugin-jsdoc": "^62.7.1",
    "eslint-plugin-n": "^15.3.0",
    "eslint-plugin-promise": "^6.0.1",
    "eslint-plugin-sort-class-members": "1.22.1",
    "globals": "^16.5.0",
    "jasmine": "^5.0.0",
    "typescript": "^5.6.3"
  },
  "jasmine": {
    "spec_dir": "spec",
    "spec_files": [
      "**/*[sS]pec.js"
    ]
  },
  "c8": {
    "reporter": [
      "text",
      "lcov"
    ],
    "extension": [
      ".js"
    ],
    "include": [
      "lib/**/*.js"
    ],
    "exclude": [
      "spec/**",
      "coverage/**",
      "report/**"
    ],
    "all": true,
    "check-coverage": false
  }
}
