{
  "name": "kerghan-backend",
  "type": "module",
  "version": "0.1.0",
  "description": "Kerghan backend — GitHub issue monitoring/dashboard API",
  "private": true,
  "main": "bin/server.js",
  "scripts": {
    "server": "node bin/server.js",
    "spec": "npx jasmine spec/**/*.js",
    "test": "npx c8 jasmine spec/**/*.js",
    "coverage": "npx c8 --reporter=lcov jasmine spec/**/*.js",
    "lint": "eslint lib bin spec",
    "lint_fix": "eslint lib bin spec --fix"
  },
  "author": "darthjee",
  "license": "UNLICENSED",
  "dependencies": {
    "express": "5.2.1",
    "mysql2": "^3.11.0",
    "sequelize": "^6.37.0"
  },
  "devDependencies": {
    "@eslint/js": "^8.0.0",
    "c8": "11.0.0",
    "eslint": "^8.0.1",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-complexity": "^1.0.2",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jasmine": "^4.1.3",
    "eslint-plugin-jsdoc": "^62.7.1",
    "eslint-plugin-n": "^15.3.0",
    "eslint-plugin-promise": "^6.0.1",
    "eslint-plugin-sort-class-members": "1.22.1",
    "globals": "^16.5.0",
    "jasmine": "^5.0.0",
    "sequelize-cli": "^6.6.0"
  },
  "jasmine": {
    "spec_dir": "spec",
    "spec_files": [
      "**/*[sS]pec.js"
    ]
  },
  "c8": {
    "reporter": [
      "text",
      "lcov"
    ],
    "extension": [
      ".js"
    ],
    "include": [
      "lib/**/*.js"
    ],
    "exclude": [
      "spec/**",
      "coverage/**",
      "report/**"
    ],
    "all": true,
    "check-coverage": false
  }
}
