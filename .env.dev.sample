# Backend framework settings
KERGHAN_SECRET_KEY=kerghan-insecure-dev-only-change-in-production
# Comma-separated retired keys, still accepted for JWT verification during a key rotation
KERGHAN_PREVIOUS_SECRET_KEYS=
KERGHAN_ACCESS_TOKEN_TTL_MS=3600000
# Refresh-token lifetimes (ms): regular (default 7 days) and "keep me signed in" (default 30 days)
# KERGHAN_REFRESH_TOKEN_TTL_MS=604800000
# KERGHAN_PERSISTENT_REFRESH_TOKEN_TTL_MS=2592000000
# Encrypts stored integration credentials (base64 of exactly 32 bytes, must differ from
# KERGHAN_SECRET_KEY). Public dev-only placeholder, refused at boot when NODE_ENV=production.
# Generate a real one with: openssl rand -base64 32
KERGHAN_INTEGRATIONS_KEY=a2VyZ2hhbi1kZXYtaW50ZWdyYXRpb25zLWtleS0zMmI=
# Comma-separated retired integrations keys, decrypt-only during a KERGHAN_INTEGRATIONS_KEY rotation
KERGHAN_PREVIOUS_INTEGRATIONS_KEYS=
# GitHub OAuth App integration type: disabled by default (leave both unset). To try it, register
# a personal OAuth App on GitHub whose Authorization callback URL is
# http://localhost:3000/integrations/oauth_app/callback (Tent's port), then set both variables.
# Setting only one of them fails boot.
# KERGHAN_GITHUB_OAUTH_APP_CLIENT_ID=
# KERGHAN_GITHUB_OAUTH_APP_CLIENT_SECRET=
# GitHub App integration type: disabled by default (leave all five unset). To try it, register a
# personal throwaway GitHub App on GitHub with:
#   - Callback URL: http://localhost:3000/integrations/github_app/callback (Tent's port)
#   - "Request user authorization (OAuth) during installation": on
#   - Webhook: inactive
#   - Repository permissions: Issues: read, Metadata: read (nothing else)
# then set all five variables. Setting only some of them fails boot.
# The private key is the base64 of the downloaded PEM file, on one line and unquoted:
#   base64 -w0 key.pem   (GNU/Linux)
#   base64 -i key.pem    (macOS)
# KERGHAN_GITHUB_APP_ID=
# KERGHAN_GITHUB_APP_SLUG=
# KERGHAN_GITHUB_APP_PRIVATE_KEY=
# KERGHAN_GITHUB_APP_CLIENT_ID=
# KERGHAN_GITHUB_APP_CLIENT_SECRET=
KERGHAN_ALLOWED_ORIGINS=http://localhost:3000
KERGHAN_LOG_LEVEL=info
NODE_ENV=development
DEBUG=true

# MySQL settings
KERGHAN_MYSQL_HOST=mysql
KERGHAN_MYSQL_PORT=3306
KERGHAN_MYSQL_USER=kerghan
KERGHAN_MYSQL_PASSWORD=kerghan
KERGHAN_MYSQL_NAME=kerghan
KERGHAN_DEMO_PASSWORD=kerghan-demo

# Email settings
KERGHAN_EMAILS_ENABLED=false
KERGHAN_EMAIL_HOST=localhost
KERGHAN_EMAIL_PORT=587
KERGHAN_EMAIL_USER=
KERGHAN_EMAIL_PASSWORD=
KERGHAN_EMAIL_USE_TLS=true
KERGHAN_EMAIL_FROM=no-reply@kerghan.local
KERGHAN_EMAIL_TIMEOUT_MS=10000
KERGHAN_EMAIL_METHOD=native

# Frontend settings
FRONTEND_DEV_MODE=true
FRONTEND_BASE_URL=http://localhost:3000

# Cache warmer (Navi)
KERGHAN_PRODUCTION_URL=http://localhost:3000
NAVI_NAMEPACE=default
