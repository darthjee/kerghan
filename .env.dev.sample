# Backend framework settings
KERGHAN_SECRET_KEY=kerghan-insecure-dev-only-change-in-production
# Comma-separated retired keys, still accepted for JWT verification during a key rotation
KERGHAN_PREVIOUS_SECRET_KEYS=
KERGHAN_ACCESS_TOKEN_TTL_MS=3600000
# Encrypts stored integration credentials (base64 of exactly 32 bytes, must differ from
# KERGHAN_SECRET_KEY). Public dev-only placeholder, refused at boot when NODE_ENV=production.
# Generate a real one with: openssl rand -base64 32
KERGHAN_INTEGRATIONS_KEY=a2VyZ2hhbi1kZXYtaW50ZWdyYXRpb25zLWtleS0zMmI=
KERGHAN_ALLOWED_ORIGINS=http://localhost:3000
KERGHAN_LOG_LEVEL=info
NODE_ENV=development
DEBUG=true

# MySQL settings
KERGHAN_MYSQL_HOST=mysql
KERGHAN_MYSQL_PORT=3306
KERGHAN_MYSQL_USER=kerghan
KERGHAN_MYSQL_PASSWORD=kerghan
KERGHAN_MYSQL_NAME=kerghan
KERGHAN_DEMO_PASSWORD=kerghan-demo

# Email settings
KERGHAN_EMAILS_ENABLED=false
KERGHAN_EMAIL_HOST=localhost
KERGHAN_EMAIL_PORT=587
KERGHAN_EMAIL_USER=
KERGHAN_EMAIL_PASSWORD=
KERGHAN_EMAIL_USE_TLS=true
KERGHAN_EMAIL_FROM=no-reply@kerghan.local
KERGHAN_EMAIL_TIMEOUT_MS=10000
KERGHAN_EMAIL_METHOD=native

# Frontend settings
FRONTEND_DEV_MODE=true
FRONTEND_BASE_URL=http://localhost:3000

# Cache warmer (Navi)
KERGHAN_PRODUCTION_URL=http://localhost:3000
NAVI_NAMEPACE=default
